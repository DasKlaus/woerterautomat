RewriteEngine On
RewriteRule ^spiel-([0-9]+)(-.*)?$ index.php?go=game&game=$1 [QSA,L]
RewriteRule ^tag-([0-9]+)-(de|en)$ index.php?go=daily&day=$1&language=$2 [L]
RewriteRule ^spiele$ index.php?go=games [QSA,L]
RewriteRule ^profil$ index.php?go=user [L]
RewriteRule ^(anleitung|neu|impressum)$ index.php?go=$1 [L]
RewriteRule ^vorschau(-([0-9]+))?\.png$ preview.php?game=$2 [L]
